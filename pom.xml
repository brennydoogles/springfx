<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Spring Boot version is set here, once, and should match what consuming apps use. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <!-- JitPack publishes multi-module builds as com.github.<user>.<repo>:<module>:<tag> (ADR-0001). -->
    <groupId>com.github.brennydoogles.springfx</groupId>
    <artifactId>springfx-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>SpringFX Parent</name>
    <description>Binds Spring Boot and JavaFX together</description>
    <url>https://github.com/brennydoogles/springfx</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/brennydoogles/springfx</url>
        <connection>scm:git:https://github.com/brennydoogles/springfx.git</connection>
    </scm>

    <modules>
        <module>springfx</module>
        <module>springfx-processor</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <javafx.version>27.0.1</javafx.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
